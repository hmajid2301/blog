{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) }}
    {{- $.Scratch.Add "index" (dict
        "title" .Title
        "permalink" .Permalink
        "section" (.Section | humanize)
        "summary" .Summary
        "date" (.Date.Format "02 Jan 2006")
        "tags" (delimit (.Params.tags | default slice) " ")
        "content" (htmlUnescape (htmlUnescape (htmlUnescape (strings.Truncate 500 .Plain))))
    ) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
